# Only needed if you are not logged in to Claude Code on this machine.
# ANTHROPIC_API_KEY=
# Optional: route Claude Agent SDK requests through a local RTK Proxy daemon.
# Enable only after starting it with `npm run rtk:proxy:start`.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8080

API_PORT=3001
# CLAUDE_MODEL=claude-sonnet-5-5
# Model for Jira / Figma MCP extraction (always low effort). Default: claude-haiku-5-5
# CLAUDE_EXTRACT_MODEL=claude-haiku-5-5
# Codex model for MCP extraction (always low reasoning effort). Unset keeps Codex's default model.
# CODEX_EXTRACT_MODEL=
# Regexes that pick the Jira / Figma MCP servers from your Claude config by name.
JIRA_MCP_MATCH=atlassian|jira
# Figma server for the MCP tab (the online claude.ai Figma connector).
FIGMA_MCP_MATCH=^figma(?:-ui-checker)?$

# Optional: Figma personal access token (scopes: File content: Read, File versions: Read).
# Used only by the Figma API tab: downloads the whole file into data/full-figma/, exact values, no AI tokens.
# FIGMA_TOKEN=

# Optional: Jira API (Jira API tab). Atlassian account email + API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Optional: test account for pages behind a login (use a test account, never a real one).
# Used when "Has login?" is on for a ticket. A run turns it on by itself when the page redirects to a login form.
# PROJECT_LOGIN_URL is optional: without it, sign-in starts at the login page the site redirects to.
# Never sent to the AI agents.
# PROJECT_USERNAME_EMAIL=
# PROJECT_PASSWORD=
# PROJECT_LOGIN_URL=https://staging.example.com/login
