{
  "name": "jira-figma-ui-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run server\" \"vite\"",
    "dev:rtk": "./.tools/rtk llm-proxy start && ANTHROPIC_BASE_URL=http://127.0.0.1:8080 npm run dev",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "setup": "node scripts/setup-env.mjs && playwright install chromium",
    "setup:browser": "playwright install chromium",
    "rtk:proxy:start": "./.tools/rtk llm-proxy start",
    "rtk:proxy:status": "./.tools/rtk llm-proxy status",
    "predev": "node --env-file-if-exists=.env scripts/free-api-port.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@playwright/test": "^1.64.1",
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.1.0",
    "vite": "^8.3.5"
  }
}
